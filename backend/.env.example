
# AI API 설정 예시
# 이 파일은 예시입니다. 실제 키를 적지 마세요.
# 로컬 실행: 이 파일을 backend/.env 로 복사한 뒤 값을 채웁니다. (.env 는 git 에 올라가지 않습니다)
# 배포: Vercel > Project Settings > Environment Variables 에 같은 이름으로 등록합니다.

CODYSSEY_API_KEY=your_api_key_here
CODYSSEY_BASE_URL=your_base_url_here

# 사용할 모델 이름. 리딩 품질을 위해 claude-opus-4-8 을 선택했습니다.
# (API 가 제공하는 정확한 모델 ID 로 적어야 합니다)
CODYSSEY_MODEL=claude-opus-4-8